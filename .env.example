# ==============================================================================
# MindMate AI - Environment Configuration Template (.env.example)
# Copy to `.env` and fill in your desired ports and API keys:
# cp .env.example .env
# ==============================================================================

# Port for the MindMate Web UI (open in browser: http://localhost:8080)
APP_PORT=8080

# Port for the Python AI Engine (http://localhost:5000/health)
AI_PORT=5000

# AI Provider: 'auto', 'gemini', 'granite', or 'local'
AI_PROVIDER=auto

# Google Gemini API Key (optional - fallback heuristics run if blank)
GEMINI_API_KEY=

# IBM Granite / watsonx API Key (optional - built-in XGBoost + PyTorch run if blank)
IBM_GRANITE_API_KEY=

# IBM Granite Model
IBM_GRANITE_MODEL=ibm/granite-13b-chat-v2

# Internal microservice URL for container communication
IBM_AI_SERVICE_URL=http://ai-engine:5000
IBM_AI_SERVICE_ENABLED=true
IBM_AI_SERVICE_TIMEOUT=2500
